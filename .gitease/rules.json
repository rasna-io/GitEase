{
  "rules": {
    "commitMessage": [
      {
        "ruleName": "Conventional Commits",
        "description": "Subject must follow type(scope): summary, stay between 10 and 72 characters, and not end with a period. Merge and revert commits generated by Git are allowed.",
        "severity": 0,
        "enabled": true,
        "minLength": "10",
        "maxLength": "72",
        "requirePrefix": true,
        "allowedPrefixes": "feat,fix,docs,style,refactor,perf,test,build,ci,chore,revert,Merge,Revert",
        "noTrailingPeriod": true,
        "imperativeVerb": true,
        "forbiddenWords": "do not merge,dnm:,[wip],wip:",
        "requireTicketRef": false,
        "ticketRefPattern": "",
        "requireBodySeparator": true,
        "bodyMinLength": "0",
        "requireSignedOffBy": false,
        "customRegex": "^((feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([\\w./-]+\\))?!?: \\S.*|Merge .+|Revert \".+\")",
        "customErrorMessage": "Use Conventional Commits: type(scope): summary, e.g. \"feat(auth): add SSO login\""
      },
      {
        "ruleName": "Ticket Reference (opt-in)",
        "description": "Enable this if every commit must reference an issue tracker key such as PROJ-123.",
        "severity": 1,
        "enabled": false,
        "minLength": "0",
        "maxLength": "0",
        "requirePrefix": false,
        "allowedPrefixes": "",
        "noTrailingPeriod": false,
        "imperativeVerb": false,
        "forbiddenWords": "",
        "requireTicketRef": true,
        "ticketRefPattern": "[A-Z][A-Z0-9]+-\\d+",
        "requireBodySeparator": false,
        "bodyMinLength": "0",
        "requireSignedOffBy": false,
        "customRegex": "",
        "customErrorMessage": ""
      }
    ],
    "branchNaming": [
      {
        "ruleName": "Branch Naming Convention",
        "description": "Branches use a type/ prefix, lowercase kebab-case, and at most 50 characters. Long-lived branches are protected.",
        "severity": 0,
        "enabled": true,
        "isActive": true,
        "allowedPrefixes": "feature/,bugfix/,hotfix/,release/,chore/,docs/",
        "maxLength": "50",
        "forbidSpaces": true,
        "forbidUppercase": true,
        "forbidSpecialChars": true,
        "requireTicketRef": false,
        "ticketRefPattern": "[A-Z][A-Z0-9]+-\\d+",
        "protectedBranches": "main,master,develop,release/*",
        "autoDeleteAfterMerge": true
      }
    ],
    "fileCode": [
      {
        "ruleName": "Secrets & Large Files",
        "description": "Blocks credentials, private keys, binaries and files over 10 MB from being committed.",
        "severity": 0,
        "enabled": true,
        "forbiddenExtensions": ".env,.pem,.key,.p12,.pfx,.jks,.keystore,.exe,.sqlite,.db",
        "maxFileSizeMb": "10",
        "noTrailingWhitespace": true,
        "requireFinalNewline": true,
        "secretPatterns": "AKIA[0-9A-Z]{16},(?i)aws_secret_access_key\\s*[:=]\\s*\\S+,-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----,ghp_[A-Za-z0-9]{36},github_pat_[A-Za-z0-9_]{82},glpat-[A-Za-z0-9_-]{20},xox[baprs]-[A-Za-z0-9-]+,sk_live_[0-9a-zA-Z]{24},AIza[0-9A-Za-z_-]{35},(?i)(password|passwd|secret|api_key)\\s*[:=]\\s*['\"][^'\"]{8}",
        "lockedFiles": "LICENSE,.gitattributes,.github/CODEOWNERS"
      }
    ],
    "pushRules": [
      {
        "ruleName": "Protected Branch Push Policy",
        "description": "No force-push to shared branches, no leftover conflict markers or WIP commits, and at most 50 commits per push.",
        "severity": 0,
        "enabled": true,
        "blockForcePushPatterns": "main,master,develop,release/*",
        "requireGpgSignature": false,
        "blockConflictMarkers": true,
        "blockWipCommits": true,
        "maxCommitsPerPush": "50"
      }
    ],
    "notification": [
      {
        "ruleName": "Violation Reporting",
        "description": "Surface rule violations in the notification center and keep an audit log inside the repository. Add a Slack, Teams or Discord webhook URL to notify a channel.",
        "severity": 1,
        "enabled": true,
        "notifyChannel": "",
        "showInNotificationCenter": true,
        "logViolationsToFile": true,
        "logFilePath": ".gitease/violations.log"
      }
    ],
    "customHooks": [
      {
        "ruleName": "Block Conflict Markers (pre-commit)",
        "description": "Rejects the commit if staged changes still contain merge conflict markers.",
        "severity": 0,
        "enabled": true,
        "trigger": "pre-commit",
        "runInBackground": false,
        "timeoutSeconds": "15",
        "scriptPath": "",
        "inlineScript": "#!/bin/sh\n# Fail when staged changes still contain merge conflict markers\nif git diff --cached -U0 | grep -E '^\\+(<<<<<<<|=======$|>>>>>>>)' >/dev/null; then\n  echo \"Conflict markers found in staged changes\"\n  exit 1\nfi\nexit 0\n",
        "envVars": "",
        "onFailure": 0
      },
      {
        "ruleName": "Run Tests Before Push (opt-in)",
        "description": "Enable and point the script path at your test runner to block pushes when tests fail.",
        "severity": 1,
        "enabled": false,
        "trigger": "pre-push",
        "runInBackground": false,
        "timeoutSeconds": "90",
        "scriptPath": "./scripts/run-tests.sh",
        "inlineScript": "",
        "envVars": "CI=true",
        "onFailure": 0
      }
    ]
  }
}